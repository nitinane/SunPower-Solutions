# Replace all CHANGE_ME values; generate with: openssl rand -hex 32
ENVIRONMENT=production
LOG_LEVEL=INFO
DOMAIN=
POSTGRES_USER=sunpower
POSTGRES_PASSWORD=CHANGE_ME_DATABASE_SECRET
POSTGRES_DB=sunpower
DATABASE_URL=postgresql+psycopg://sunpower:CHANGE_ME_DATABASE_SECRET@db:5432/sunpower
REDIS_URL=redis://redis:6379/0
JWT_SECRET=CHANGE_ME_JWT_SECRET
JWT_EXPIRE_MINUTES=480
CORS_ORIGINS=
STORAGE_DIR=/app/storage
MAX_UPLOAD_MB=10
WEB_CONCURRENCY=2
SERVICE_LABOUR_RATE_PER_HOUR=500
SERVICE_LABOUR_GST_PERCENT=18
SEED_PASSWORD=CHANGE_ME_SEED_PASSWORD
DEMO_PASSWORD=CHANGE_ME_DEMO_PASSWORD
